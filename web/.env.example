# ====================================
# Conductor Web environment variable template
# ====================================
# Usage:
# 1. Local development: copy this file to .env.local and fill in the real values
# 2. Vercel deployment: copy to .env.production.vercel
# 3. Volcengine deployment: copy to .env.production.volcengine
# ====================================

# ====== Network Configuration ======

# Host address for the backend service
# Purpose: controls which network interface the Next.js server binds to
# Applies to: all environments
# Local development: localhost (local-only access)
# Production: 0.0.0.0 (allow external access)
HOST=localhost

# Backend service port
# Purpose: port used by the Next.js backend
# Applies to: all environments
PORT=6152

# Allowed CORS origins, comma separated
# Purpose: configure the cross-origin allowlist to prevent unauthorized cross-origin access
# Applies to: all environments; adjust to match your deployment domain
# Local development: include localhost and 0.0.0.0
# Production: replace with your production domain
CORS_ORIGINS=http://localhost:6152,http://0.0.0.0:6152,http://localhost:6151,http://0.0.0.0:6151

# Base URL for the backend API
# Purpose: base address used by the frontend to call backend APIs
# Applies to: frontend code, both browser and server
# Local development: http://localhost:6152
# Production: https://yourdomain.com
API_BASE_URL=http://localhost:6152

# ====== Cache Configuration ======

# Redis connection URL
# Purpose: used for session storage, caching, queues, and similar features
# Applies to: environments that need Redis caching (optional)
# Local development: local Redis instance
# Production: Redis cloud service or self-hosted instance
REDIS_URL=redis://127.0.0.1:6379

# ====== Admin Panel Configuration ======

# Admin email address used to log in to the admin panel
# Purpose: admin panel login account
# Applies to: all environments; production should use a real email address
ADMIN_EMAIL=admin@example.com

# Admin password
# Purpose: admin panel login password
# Applies to: all environments; production must use a strong password
ADMIN_PASSWORD=admin

# Admin panel cookie signing secret
# Purpose: protects admin session cookies from tampering
# Applies to: all environments; production must use a random strong secret
ADMIN_COOKIE_SECRET=conductor-admin-cookie-secret-change-in-production

# ====== Next.js (web_v2) Core Configuration ======

# Prisma database connection URL
# Purpose: Prisma ORM connection string
# Applies to: all environments
# Local development: SQLite
# Production: PostgreSQL is recommended (postgresql://user:pass@host:5432/conductor)
# Note: use an absolute path or cloud database in production
DATABASE_URL=file:/absolute/path/to/prisma/schema.sqlite.db
# DATABASE_URL=postgresql://user:password@host:5432/conductor

# Prisma database dialect, sqlite or postgres
# Applies to: all environments
DB_DIALECT="sqlite"

# Public application URL, accessible from the browser
# Purpose: used to generate absolute URLs, OAuth callback URLs, email links, and similar values
# Applies to: Next.js server code and browser code exposed via NEXT_PUBLIC_
# Local development: http://localhost:6152
# Production: https://yourdomain.com
NEXT_PUBLIC_URL=http://localhost:6152

# JWT signing secret
# Purpose: signs and verifies user tokens
# Applies to: identity and authentication systems in all environments
# Security: production must use a long random string (at least 32 characters)
# Suggested generation: openssl rand -base64 32
JWT_SECRET=conductor-jwt-secret-change-in-production

# Development shortcut authentication
# Purpose: skip the real SMS/email flow during local debugging
# Applies to: local development only
# Security: production must remove this or leave it empty, otherwise it is a serious security risk
AUTH_DEV_CODE=

# Attachment storage root directory, optional
# Purpose: local on-disk storage for uploaded images, videos, audio, and similar files
# Default: <web cwd>/.conductor-data/task-attachments
CONDUCTOR_FILE_STORAGE_DIR=

# Attachment retention time in minutes
# Purpose: controls how long uploaded attachments remain on disk
# Default: 10
CONDUCTOR_ATTACHMENT_TTL_MINUTES=10

# Attachment sweeper interval in milliseconds
# Purpose: background cleanup interval for deleting expired attachments and reclaiming disk space
# Default: 60000
CONDUCTOR_ATTACHMENT_SWEEP_INTERVAL_MS=60000

# ====== Third-Party Service Configuration, optional ======

# ----- Aliyun SMS -----
# Purpose: send SMS verification messages for registration, login, and password recovery
# Applies to: environments that need phone-based authentication
# Docs: https://www.aliyun.com/product/sms

# Aliyun Access Key ID
ALIYUN_ACCESS_KEY_ID=

# Aliyun Access Key Secret
ALIYUN_ACCESS_KEY_SECRET=

# SMS signature, applied for in the Aliyun console
ALIYUN_SMS_SIGN_NAME=

# SMS template code, applied for in the Aliyun console
ALIYUN_SMS_TEMPLATE_CODE=

# ----- Volcengine SMS -----
# Purpose: send SMS verification messages for registration, login, and password recovery
# Applies to: environments that need phone-based authentication
# Docs: https://www.volcengine.com/product/cloud-sms

# Volcengine Access Key ID
VOLC_ACCESS_KEY_ID=

# Volcengine Secret Access Key
VOLC_SECRET_ACCESS_KEY=

# SMS account, also known as the message group ID
VOLC_SMS_ACCOUNT=

# SMS signature
VOLC_SMS_SIGN_NAME=

# SMS template ID
VOLC_SMS_TEMPLATE_ID=

# International SMS template ID, used for phone numbers outside the +86 country code
VOLC_SMS_TEMPLATE_ID_OVERSEAS=

# ----- Resend email service -----
# Purpose: send email verification messages and notification emails
# Applies to: environments that need email functionality
# Docs: https://resend.com

# Resend API key
RESEND_API_KEY=

# From address, must be verified in Resend
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ----- Stripe payments -----
# Purpose: process credit card payments for international users
# Applies to: environments that need online payments
# Docs: https://stripe.com

# Stripe secret key, used on the backend
STRIPE_SECRET_KEY=

# Stripe webhook signing secret, used to verify payment callbacks
STRIPE_WEBHOOK_SECRET=

# Stripe publishable key, used on the frontend and safe to expose to the browser
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ----- Alipay payments -----
# Purpose: process Alipay payments for users in China
# Applies to: environments that need Alipay payments
# Docs: https://open.alipay.com

# Alipay app ID
ALIPAY_APP_ID=

# Alipay private key, used to sign requests
ALIPAY_PRIVATE_KEY=

# Alipay public key, used to verify Alipay responses
ALIPAY_PUBLIC_KEY=

# ----- Feishu Channel Gateway -----
# Purpose: connect Feishu bot webhooks and message callbacks
# Applies to: environments that use the Feishu DM / group chat entry point

# Feishu OpenAPI base URL, usually the official URL and rarely needs to change
FEISHU_API_BASE_URL=https://open.feishu.cn

# ----- Google OAuth login -----
# Purpose: allow users to log in with Google accounts
# Applies to: environments that need third-party login
# Docs: https://console.cloud.google.com

# Google OAuth client ID
GOOGLE_CLIENT_ID=

# Google OAuth client secret
GOOGLE_CLIENT_SECRET=

# ----- GitHub OAuth login -----
# Purpose: allow users to log in with GitHub accounts
# Applies to: environments that need third-party login
# Docs: https://github.com/settings/developers

# GitHub OAuth client ID
GITHUB_CLIENT_ID=

# GitHub OAuth client secret
GITHUB_CLIENT_SECRET=

# PTY settings
PTY_TRANSPORT_POLICY=direct_preferred
