# Nginx site config for Conductor (web v2)
# Reverse proxy to the Next.js server, including WebSocket upgrades.
# Place inside http { ... } or copy into sites-available.
#
# ---------------------------------------------------------------------------
# DOMAIN STATE — read this before adding a location block.
#
# The canonical host is `conductor.conductor-ai.top`. Every daemon, every CLI
# and the web UI talk to it; it is the ONLY host that serves real traffic.
#
# `conductor-ai.top` (the apex) is RETIRED and kept solely as a 301 to the
# canonical host. Do not add proxy rules to it — a request that reaches the
# apex should bounce, not be served.
#
# Why this warning exists: the 2026-06-30 migration to the subdomain created
# the new vhost BY HAND on the box and deliberately left the apex alone
# ("dual-domain coexistence, this phase"). The phase never ended, the SOP
# recording it was deleted a month later as "useless files", and this file —
# the only nginx config in the repo and the only one deploy-prod.sh ships —
# went on describing the dead apex. RFC 0037's file-transfer limits landed
# here, i.e. on the retired host, so `conductor remote cp` 413'd on anything
# over 20 MB in production while every test against this file looked fine.
#
# The fix is that this file now describes the canonical host. Keep it that way:
# a new location block belongs in the `conductor.conductor-ai.top` server, and
# there should never be a second Conductor vhost living only on the box.
# ---------------------------------------------------------------------------

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# Retired apex: bounce everything to the canonical subdomain. Its certificate
# must stay renewed for as long as this block exists, or the redirect itself
# fails TLS before it can redirect.
server {
  listen 80;
  server_name conductor-ai.top;

  return 301 https://conductor.conductor-ai.top$request_uri;
}

server {
  listen 443 ssl http2;
  server_name conductor-ai.top;

  ssl_certificate /etc/letsencrypt/live/conductor-ai.top/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/conductor-ai.top/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

  return 301 https://conductor.conductor-ai.top$request_uri;
}

server {
  listen 80;
  server_name conductor.conductor-ai.top;

  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name conductor.conductor-ai.top;

  ssl_certificate /etc/letsencrypt/live/conductor.conductor-ai.top/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/conductor.conductor-ai.top/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

  # Must stay >= MAX_ATTACHMENT_BYTES + multipart overhead in
  # web/src/app/api/tasks/[taskId]/attachments/route.ts (100 MB + 1 MB).
  client_max_body_size 110m;

  # WebSocket endpoints
  location /ws/ {
    proxy_pass http://127.0.0.1:6152;
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    proxy_read_timeout 86400;
  }

  # Serve Next.js static files directly
  location /_next/static/ {
    alias /opt/conductor/conductor/web/.next/static/;
    expires 1y;
    access_log off;
    add_header Cache-Control "public, immutable";
  }

  # Remote file transfer (RFC 0037): whole files move through these two route
  # families, so they need their own body limit. This cap is PER CHUNK, not per
  # file: uploads are split into 32 MiB `Content-Range` chunks, so a 1 GiB
  # transfer is ~32 requests of at most 32 MiB each and never one 1 GiB body.
  # 64m leaves headroom for a larger chunk size without touching ops again.
  # `proxy_request_buffering off` keeps nginx from spooling each chunk to a temp
  # file before Next.js sees a byte. Must precede `location /` to win the regex
  # match.
  location ~ ^/api/(agents/[^/]+/files|agent/files)(/|$) {
    client_max_body_size 64m;
    proxy_request_buffering off;

    # These are between two successive reads, not a total, so a steadily
    # streaming 1 GiB body never trips them. The default 60s is still too tight:
    # the daemon can take longer than that to produce the first byte of a large
    # download while it hashes and seeks.
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    proxy_pass http://127.0.0.1:6152;
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_cache_bypass 1;
    proxy_no_cache 1;
  }

  # All app/API routes handled by Next.js
  location / {
    proxy_pass http://127.0.0.1:6152;
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Never let any intermediate proxy cache HTML responses, even when Next
    # emits long s-maxage headers during the brief restart window.
    proxy_cache_bypass 1;
    proxy_no_cache 1;

    # Stream large uploads straight through. With the default buffering nginx
    # spools the whole body to disk before Next.js sees a byte, so an oversized
    # or unsupported upload still pays full transfer cost before being rejected.
    proxy_request_buffering off;
  }
}
