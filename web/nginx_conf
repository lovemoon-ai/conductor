# Nginx site config for Conductor (web v2)
# Reverse proxy to the Next.js server, including WebSocket upgrades.
# Place inside http { ... } or copy into sites-available.

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 80;
  server_name conductor-ai.top;

  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name conductor-ai.top;

  ssl_certificate /etc/letsencrypt/live/conductor-ai.top/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/conductor-ai.top/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

  client_max_body_size 20m;

  # WebSocket endpoints
  location /ws/ {
    proxy_pass http://127.0.0.1:6152;
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    proxy_read_timeout 86400;
  }

  # Serve Next.js static files directly
  location /_next/static/ {
    alias /opt/conductor/conductor/web/.next/static/;
    expires 1y;
    access_log off;
    add_header Cache-Control "public, immutable";
  }

  # All app/API routes handled by Next.js
  location / {
    proxy_pass http://127.0.0.1:6152;
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Never let any intermediate proxy cache HTML responses, even when Next
    # emits long s-maxage headers during the brief restart window.
    proxy_cache_bypass 1;
    proxy_no_cache 1;
  }
}
