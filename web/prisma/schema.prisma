generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String      @id @default(uuid())
  email              String?     @unique
  phone              String?     @unique
  passwordHash       String      @map("password_hash")
  passwordSalt       String      @map("password_salt")
  provider           String      @default("LOCAL")
  providerId         String?     @map("provider_id")
  region             String      @default("INTL")
  inviteCode         String?     @unique @map("invite_code")
  invitedByUserId    String?     @map("invited_by_user_id")
  inviteRegisteredRewardAt DateTime? @map("invite_registered_reward_at")
  invitePlusRewardAt DateTime?   @map("invite_plus_reward_at")
  subscriptionStatus String      @default("FREE_TRIAL") @map("subscription_status")
  subscriptionTier   String      @default("FREE") @map("subscription_tier")
  trialEndsAt        DateTime?   @map("trial_ends_at")
  subscriptionEndsAt DateTime?   @map("subscription_ends_at")
  lastPaymentAt      DateTime?   @map("last_payment_at")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  projects Project[]
  defaultProject DefaultProject? @relation("UserDefaultProject")
  tokens   UserToken[]
  preferences UserPreference[]
  catchphrases UserCatchphrase[]
  orders   Order[]
  externalAccounts ExternalAccount[]
  channelConversations ChannelConversation[]
  channelProviderConfigs ChannelProviderConfig[]
  sharedTasks SharedTask[]
  collaborationMemberships CollaborationMember[]
  ownedIssues Issue[] @relation("IssueOwner")
  createdIssues Issue[] @relation("IssueCreator")
  invitedBy User? @relation("UserInvites", fields: [invitedByUserId], references: [id])
  invitedUsers User[] @relation("UserInvites")
  scheduledMessages ScheduledMessage[]
  dailyReportSetting DailyReportSetting?
  dailyReportRuns DailyReportRun[]

  @@unique([provider, providerId])
  @@index([email])
  @@index([phone])
  @@index([invitedByUserId])
  @@map("users")
}

model UserToken {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  name        String?
  tokenHash   String    @map("token_hash")
  tokenSalt   String    @map("token_salt")
  tokenPrefix String    @map("token_prefix")
  tokenValue  String?   @map("token_value")
  lastUsedAt  DateTime? @map("last_used_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenPrefix])
  @@map("user_tokens")
}

model UserPreference {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  key       String
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
  @@map("user_preferences")
}

/// Per-user catchphrase library (RFC 0032). Each row is a short phrase the
/// user frequently sends to AI; the entire set is global to the user and
/// surfaced via the empty-input double-click popover in the chat composer.
model UserCatchphrase {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  text       String
  sortOrder  Int       @default(0) @map("sort_order")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sortOrder])
  @@map("user_catchphrases")
}

model Project {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  name          String
  daemonHost    String?  @map("daemon_host")
  workspacePath String?  @map("workspace_path")
  repoRoot      String?  @map("repo_root")
  worktreeBranch String? @map("worktree_branch")
  lastCommit    String?  @map("last_commit")
  lastCommitAt  DateTime? @map("last_commit_at")
  gitRemoteUrl  String?  @map("git_remote_url")
  fileCount     Int?     @map("file_count")
  sortOrder     Int      @default(0) @map("sort_order")
  hiddenAt      DateTime? @map("hidden_at")
  mergeOptOut   Boolean  @default(false) @map("merge_opt_out")
  collaborationId String? @map("collaboration_id")
  metadata      String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  collaboration ProjectCollaboration? @relation(fields: [collaborationId], references: [id], onDelete: SetNull)
  collaborationMember CollaborationMember?
  defaultProject DefaultProject? @relation("ProjectDefaultProject")
  tasks Task[]
  issues Issue[]
  channelConversations ChannelConversation[]

  @@index([userId])
  @@index([userId, name])
  @@index([userId, daemonHost])
  @@index([userId, workspacePath])
  @@index([userId, hiddenAt])
  @@index([collaborationId])
  @@unique([userId, daemonHost, name])
  @@unique([userId, daemonHost, workspacePath])
  @@map("projects")
}

model ProjectCollaboration {
  id          String   @id @default(uuid())
  inviteToken String   @unique @map("invite_token")
  createdAt   DateTime @default(now()) @map("created_at")

  members  CollaborationMember[]
  projects Project[]

  @@map("project_collaborations")
}

model CollaborationMember {
  id              String   @id @default(uuid())
  collaborationId String   @map("collaboration_id")
  userId          String   @map("user_id")
  projectId       String   @unique @map("project_id")
  joinedAt        DateTime @default(now()) @map("joined_at")

  collaboration ProjectCollaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([collaborationId, userId])
  @@index([userId])
  @@index([collaborationId])
  @@map("collaboration_members")
}

model Issue {
  id            String   @id @default(uuid())
  projectId     String   @map("project_id")
  ownerUserId   String?  @map("owner_user_id")
  creatorUserId String?  @map("creator_user_id")
  title         String
  description   String?
  status        String   @default("backlog")
  priority      String   @default("P1")
  position      Float    @default(0)
  metadata      String?
  aiBackendType String?  @map("ai_backend_type")
  aiSessionId   String?  @map("ai_session_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   User?   @relation("IssueOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  creator User?   @relation("IssueCreator", fields: [creatorUserId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
  @@index([projectId, status, position])
  @@index([ownerUserId])
  @@index([creatorUserId])
  @@map("issues")
}

model DefaultProject {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  projectId String   @unique @map("project_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation("UserDefaultProject", fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation("ProjectDefaultProject", fields: [projectId], references: [id], onDelete: Cascade)

  @@map("default_projects")
}

model Task {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  /// Display-only secondary project. When set on a task whose real
  /// `projectId` is the user's default project, the frontend shows the task
  /// under this project instead of the default one. It NEVER changes
  /// `projectId`, the daemon, the session, or any runtime behaviour — it is a
  /// pure presentation override, cleared (null) to move the task back to the
  /// default project. Only default-project tasks may carry a value.
  secondProjectId String? @map("second_project_id")
  issueId   String?  @map("issue_id")
  title     String
  taskType  String   @default("ai_task") @map("task_type")
  status    String   @default("pending")
  agentHost String?  @map("agent_host")
  executionHost String? @map("execution_host")
  backendType String? @map("backend_type")
  sessionId String? @map("session_id")
  sessionFilePath String? @map("session_file_path")
  launchConfig String? @map("launch_config")
  metadata  String?
  /// RFC 0029: discriminates how a task entered the `killed` state so restart
  /// can decide whether the live fire (if any) is reclaimable. Values are
  /// soft enum strings: `user_stopped`, `daemon_disconnected`, `fire_exit`,
  /// `crash`, `unknown`. Only `daemon_disconnected` is reclaim-eligible.
  killedReason String? @map("killed_reason")
  killedAt     DateTime? @map("killed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issue    Issue?    @relation(fields: [issueId], references: [id], onDelete: SetNull)
  messages Message[]
  ptySession PtySession?
  taskStatusEvents TaskStatusEvent[]
  channelConversations ChannelConversation[]
  channelOutboxEntries ChannelOutbox[]
  sharedTasks SharedTask[]
  scheduledMessages ScheduledMessage[]
  runtimeState TaskRuntimeState?
  /// One-to-one back-reference: this AI task may have one attached terminal
  /// (the relationship row, not the PTY task itself).
  attachedAsAiTask  AttachedTerminal? @relation("AttachedTerminalAiTask")
  /// One-to-one back-reference: this PTY task may be attached to one AI task.
  attachedAsPtyTask AttachedTerminal? @relation("AttachedTerminalPtyTask")

  @@index([projectId])
  @@index([secondProjectId])
  @@index([issueId])
  @@index([executionHost])
  @@map("tasks")
}

/// Relationship row binding an AI task to a PTY task that serves as its
/// in-place terminal. The PTY itself remains a regular Task(task_type=pty_task)
/// so the daemon protocol, websocket routing, and TerminalView all stay
/// untouched. This table is the single source of truth for the attachment;
/// the main task list query is the only place that needs to filter PTY tasks
/// appearing as ptyTaskId out of the top-level list.
model AttachedTerminal {
  id        String   @id @default(uuid())
  aiTaskId  String   @unique @map("ai_task_id")
  ptyTaskId String   @unique @map("pty_task_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  aiTask  Task @relation("AttachedTerminalAiTask",  fields: [aiTaskId],  references: [id], onDelete: Cascade)
  ptyTask Task @relation("AttachedTerminalPtyTask", fields: [ptyTaskId], references: [id], onDelete: Cascade)

  @@index([aiTaskId])
  @@index([ptyTaskId])
  @@map("attached_terminals")
}

model PtySession {
  id            String    @id @default(uuid())
  taskId        String    @unique @map("task_id")
  state         String    @default("pending")
  entrypointType String?  @map("entrypoint_type")
  toolPreset    String?   @map("tool_preset")
  commandJson   String?   @map("command_json")
  cwd           String?
  envJson       String?   @map("env_json")
  shell         String?
  pid           Int?
  cols          Int?
  rows          Int?
  lastOutputSeq Int       @default(0) @map("last_output_seq")
  startedAt     DateTime? @map("started_at")
  closedAt      DateTime? @map("closed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([state])
  @@map("pty_sessions")
}

model Message {
  id              String   @id @default(uuid())
  taskId          String   @map("task_id")
  role            String
  content         String
  metadata        String?
  clientMessageId String?  @unique @map("client_message_id")
  createdAt       DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([clientMessageId])
  @@map("messages")
}

model TaskStatusEvent {
  id            String   @id @default(uuid())
  taskId         String   @map("task_id")
  statusEventId  String   @unique @map("status_event_id")
  status         String
  summary        String?
  createdAt      DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_status_events")
}

model TaskRuntimeState {
  taskId          String   @id @map("task_id")
  projectId       String?  @map("project_id")
  state           String?
  phase           String?
  source          String?
  replyInProgress Boolean  @default(false) @map("reply_in_progress")
  statusLine      String?  @map("status_line")
  statusDoneLine  String?  @map("status_done_line")
  replyPreview    String?  @map("reply_preview")
  replyTo         String?  @map("reply_to")
  backend         String?
  sessionId       String?  @map("session_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("task_runtime_states")
}

model ScheduledMessage {
  id                     String    @id @default(uuid())
  userId                 String    @map("user_id")
  taskId                 String    @map("task_id")
  sourceMessageId        String?   @map("source_message_id")
  content                String
  kind                   String
  condition              String    @default("none")
  intervalMs             Int?      @map("interval_ms")
  timezone               String?
  status                 String    @default("active")
  nextRunAt              DateTime  @map("next_run_at")
  runCount               Int       @default(0) @map("run_count")
  skipCount              Int       @default(0) @map("skip_count")
  failureCount           Int       @default(0) @map("failure_count")
  maxRuns                Int?      @map("max_runs")
  maxSkips               Int?      @map("max_skips")
  stopAt                 DateTime? @map("stop_at")
  stopWhenTaskNotRunning Boolean   @default(true) @map("stop_when_task_not_running")
  lastRunAt              DateTime? @map("last_run_at")
  lastError              String?   @map("last_error")
  metadata               String?
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, status, nextRunAt])
  @@index([taskId, status])
  @@index([status, nextRunAt])
  @@index([sourceMessageId])
  @@map("scheduled_messages")
}

model DailyReportSetting {
  id               String    @id @default(uuid())
  userId           String    @unique @map("user_id")
  enabled          Boolean   @default(false)
  timezone         String    @default("Asia/Shanghai")
  sendTimeLocal    String    @default("20:00") @map("send_time_local")
  deliveryChannels String    @default("[\"in_app\"]") @map("delivery_channels")
  nextRunAt        DateTime? @map("next_run_at")
  lastSentForDate  String?   @map("last_sent_for_date")
  lastRunAt        DateTime? @map("last_run_at")
  lastError        String?   @map("last_error")
  metadata         String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([enabled, nextRunAt])
  @@map("daily_report_settings")
}

model DailyReportRun {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  reportDate       String    @map("report_date")
  timezone         String
  status           String    @default("generated")
  summaryMarkdown  String    @map("summary_markdown")
  payloadJson      String    @map("payload_json")
  deliveryChannels String    @default("[\"in_app\"]") @map("delivery_channels")
  sentAt           DateTime? @map("sent_at")
  lastError        String?   @map("last_error")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reportDate])
  @@index([userId, createdAt])
  @@map("daily_report_runs")
}

model AgentOutbox {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  agentHost   String?   @map("agent_host")
  taskId      String?   @map("task_id")
  eventType   String    @map("event_type")
  requestId   String    @unique @map("request_id")
  payloadJson String    @map("payload_json")
  status      String    @default("pending") // pending, sent, acked, failed, expired, moved_to_dlq
  attemptCount Int      @default(0) @map("attempt_count")
  maxAttempts Int      @default(20) @map("max_attempts")
  ttlHours    Int      @default(24) @map("ttl_hours")
  expiresAt   DateTime? @map("expires_at")
  nextRetryAt DateTime? @map("next_retry_at")
  lastError   String?   @map("last_error")
  sentAt      DateTime? @map("sent_at")
  ackedAt     DateTime? @map("acked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([userId, status, nextRetryAt])
  @@index([userId, agentHost, status, nextRetryAt])
  @@index([taskId])
  @@index([expiresAt])
  @@map("agent_outbox")
}

model DeadLetterQueue {
  id             String   @id @default(uuid())
  originalId     String   @map("original_id")
  userId         String   @map("user_id")
  agentHost      String?  @map("agent_host")
  taskId         String?  @map("task_id")
  eventType      String   @map("event_type")
  payload        String   @map("payload")
  failedReason   String   @map("failed_reason")
  attemptHistory String?  @map("attempt_history")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("dead_letter_queue")
}

model TaskDiagnosticsSnapshot {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  projectId   String?  @map("project_id")
  taskId      String   @map("task_id")
  trigger     String
  payloadJson String   @map("payload_json")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId, taskId, createdAt])
  @@index([projectId, createdAt])
  @@map("task_diagnostics_snapshots")
}

model SharedTask {
  id        String    @id @default(uuid())
  taskId    String    @map("task_id")
  userId    String    @map("user_id")
  token     String    @unique
  /// "user" for human-facing shares; "resume_handoff" for internal transcripts
  /// that a successor backend fetches during cross-backend restart.
  kind      String    @default("user")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId, kind])
  @@index([taskId])
  @@index([userId])
  @@map("shared_tasks")
}

model Verification {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  target    String
  code      String
  type      String
  expiresAt DateTime @map("expires_at")
  verified  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([target, code])
  @@map("verifications")
}

model SsoAuthorizationCode {
  id          String    @id @default(uuid())
  clientId    String    @map("client_id")
  userId      String    @map("user_id")
  redirectUri String    @map("redirect_uri")
  codeHash    String    @map("code_hash")
  codeSalt    String    @map("code_salt")
  codePrefix  String    @map("code_prefix")
  expiresAt   DateTime  @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([clientId, codePrefix])
  @@index([userId, createdAt])
  @@map("sso_authorization_codes")
}

model DeviceAuthSession {
  id                String    @id @default(uuid())
  deviceCodeHash    String    @map("device_code_hash")
  deviceCodeSalt    String    @map("device_code_salt")
  deviceCodePrefix  String    @map("device_code_prefix")
  userCode          String    @unique @map("user_code")
  status            String    @default("pending")
  requestedByIp     String?   @map("requested_by_ip")
  cliVersion        String?   @map("cli_version")
  hostname          String?
  platform          String?
  backendUrl        String?   @map("backend_url")
  expiresAt         DateTime  @map("expires_at")
  approvedAt        DateTime? @map("approved_at")
  deniedAt          DateTime? @map("denied_at")
  consumedAt        DateTime? @map("consumed_at")
  approvedByUserId  String?   @map("approved_by_user_id")
  issuedUserTokenId String?   @map("issued_user_token_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([deviceCodePrefix, status])
  @@index([expiresAt, status])
  @@index([approvedByUserId])
  @@map("device_auth_sessions")
}


model ExternalAccount {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  provider        String
  externalUserId  String   @map("external_user_id")
  externalUnionId String?  @map("external_union_id")
  tenantKey       String?  @map("tenant_key")
  metadata        String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, externalUserId])
  @@unique([provider, externalUnionId])
  @@index([userId])
  @@map("external_accounts")
}

model ChannelConversation {
  id                    String   @id @default(uuid())
  provider              String
  externalChatId        String   @map("external_chat_id")
  externalThreadId      String   @default("") @map("external_thread_id")
  externalRootMessageId String?  @map("external_root_message_id")
  userId                String   @map("user_id")
  projectId             String?  @map("project_id")
  taskId                String?  @map("task_id")
  boundDaemonName       String?  @map("bound_daemon_name")
  status                String   @default("ACTIVE")
  metadata              String?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  inboxEntries ChannelInbox[]
  outboxEntries ChannelOutbox[]

  @@unique([provider, externalChatId, externalThreadId])
  @@index([userId, taskId])
  @@index([projectId])
  @@map("channel_conversations")
}

model ChannelInbox {
  id                String    @id @default(uuid())
  provider          String
  externalEventId   String?   @map("external_event_id")
  externalMessageId String    @map("external_message_id")
  conversationId    String?   @map("conversation_id")
  payloadJson       String    @map("payload_json")
  status            String    @default("pending")
  error             String?
  createdAt         DateTime  @default(now()) @map("created_at")
  processedAt       DateTime? @map("processed_at")

  conversation ChannelConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@unique([provider, externalMessageId])
  @@index([provider, externalEventId])
  @@index([conversationId])
  @@map("channel_inbox")
}

model ChannelOutbox {
  id                   String    @id @default(uuid())
  provider             String
  userId               String    @map("user_id")
  conversationId       String    @map("conversation_id")
  taskId               String?   @map("task_id")
  targetChatId         String    @map("target_chat_id")
  targetReplyMessageId String?   @map("target_reply_message_id")
  targetThreadId       String?   @map("target_thread_id")
  targetTopicId        String?   @map("target_topic_id")
  eventType            String    @map("event_type")
  dedupeKey            String    @unique @map("dedupe_key")
  payloadJson          String    @map("payload_json")
  status               String    @default("pending")
  attemptCount         Int       @default(0) @map("attempt_count")
  nextRetryAt          DateTime? @map("next_retry_at")
  lastError            String?   @map("last_error")
  sentAt               DateTime? @map("sent_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  conversation ChannelConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  task         Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([status, nextRetryAt])
  @@index([userId, taskId])
  @@index([conversationId])
  @@map("channel_outbox")
}

model ChannelProviderConfig {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  provider          String
  appId             String   @map("app_id")
  appSecret         String   @map("app_secret")
  verificationToken String   @map("verification_token")
  encryptKey        String?  @map("encrypt_key")
  defaultDaemonName String?  @map("default_daemon_name")
  metadata          String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@unique([provider, verificationToken])
  @@index([provider, appId])
  @@map("channel_provider_configs")
}

model Order {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  amount          Int
  currency        String   @default("CNY")
  provider        String
  providerOrderId String?  @map("provider_order_id")
  status          String   @default("PENDING")
  metadata        String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerOrderId])
  @@map("orders")
}
